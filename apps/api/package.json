{
  "name": "@capidocs/api",
  "version": "0.1.0",
  "description": "Backoffice API for capidocs studio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --experimental-strip-types src/server.ts",
