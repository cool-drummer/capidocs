    "@fastify/cookie": "^11.1.2",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
