      "edges": [
        { "id": "e-buyer-web", "from": "buyer", "to": "web", "label": "Navega" },
        { "id": "e-web-api", "from": "web", "to": "api", "label": "HTTPS" },
        { "id": "e-api-db", "from": "api", "to": "data", "style": "dashed" },
        { "id": "e-api-pay", "from": "api", "to": "payments", "label": "Cobro", "arrow": "both" }
      ],
      "steps": [
        { "title": "El comprador entra al sitio", "nodes": ["buyer", "web"], "edges": ["e-buyer-web"] },
        { "title": "El sitio consulta la API", "nodes": ["web", "api"], "edges": ["e-web-api"] },
        { "title": "La API guarda el pedido", "nodes": ["api", "db", "orders"], "edges": ["e-api-db"] }
      ]
    },
    {
      "id": "lineage",
      "title": "Linaje de datos",
      "category": "technical",
      "lanes": [
        { "id": "ingest", "title": "Ingesta", "icons": ["workflow"] },
        { "id": "store", "title": "Almacén", "icons": ["cpu"] },
        { "id": "serve", "title": "Consumo", "icons": ["briefcase"] }
      ],
      "nodes": [
        { "id": "raw", "title": "Eventos crudos", "subtitle": "raw.events", "lane": "ingest", "badge": { "text": "Kafka", "color": "orange" } },
        { "id": "clean", "title": "Eventos limpios", "subtitle": "stage.events", "lane": "store", "badge": { "text": "Postgres", "color": "blue" } },
        { "id": "report", "title": "Reporte diario", "subtitle": "bi.daily", "lane": "serve", "badge": { "text": "BI", "color": "pink" } }
      ],
      "edges": [
        { "from": "raw", "to": "clean", "label": "Limpieza" },
        { "from": "clean", "to": "report", "label": "Agregado" }
      ]
    },
    {
      "id": "checkout",
      "title": "Flujo de compra",
      "category": "operational",
      "kind": "sequence",
      "autonumber": true,
      "participants": [
        { "id": "buyer", "title": "Comprador", "kind": "actor" },
        { "id": "web", "title": "Sitio web" },
        { "id": "api", "title": "API", "link": { "diagram": "overview", "node": "api" } },
        { "id": "psp", "title": "Pasarela", "kind": "external" }
      ],
      "items": [
        { "id": "m-pay", "from": "buyer", "to": "web", "label": "Confirma el pago" },
        { "from": "web", "to": "api", "label": "POST /orders" },
        { "type": "block", "kind": "alt", "label": "Tarjeta aprobada", "items": [
          { "from": "api", "to": "psp", "label": "Autoriza cargo" },
          { "from": "psp", "to": "api", "label": "Aprobado", "style": "reply" }
        ], "branches": [ { "label": "Rechazada", "items": [ { "from": "api", "to": "web", "label": "Error amigable", "style": "reply" } ] } ] },
        { "type": "note", "over": ["web", "api"], "text": "El pedido queda pendiente hasta la confirmación." },
        { "from": "api", "to": "api", "label": "Registra auditoría", "style": "async" }
      ],
      "steps": [ { "title": "Confirmación", "edges": ["m-pay"] } ]
    }
  ]
}
