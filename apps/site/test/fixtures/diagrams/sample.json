      "direction": "LR",
      "groups": [
        { "id": "platform", "title": "Plataforma", "icon": "cpu", "color": "blue" },
        { "id": "data", "title": "Datos", "parent": "platform", "color": "teal" }
      ],
      "nodes": [
        { "id": "buyer", "title": "Comprador", "shape": "actor" },
        { "id": "web", "title": "Sitio web", "subtitle": "apps/web", "icon": "storefront", "group": "platform", "badge": { "text": "Vue", "color": "green" }, "link": { "diagram": "checkout" }, "status": "ok",
          "props": [ { "label": "Estado", "value": "Estable", "status": "ok" }, { "label": "Responsable", "value": "Equipo web" }, { "label": "Repositorio", "value": "github.com/acme/web", "mono": true } ],
          "preview": { "type": "sparkline", "title": "Peticiones por minuto", "values": [3, 5, 9, 14, 12, 10, 11, 9, 8, 7] } },
        { "id": "api", "title": "API", "subtitle": "apps/api", "group": "platform", "badge": "Node", "tags": ["backend"] },
        { "id": "db", "title": "Base de datos", "shape": "cylinder", "group": "data", "tags": ["backend"] },
        { "id": "orders", "title": "orders", "shape": "table", "group": "data", "fields": [ { "name": "id", "type": "uuid", "key": "pk" }, { "name": "customer_id", "type": "uuid", "key": "fk" }, { "name": "total", "type": "numeric(12,2)" } ] },
        { "id": "payments", "title": "Pasarela de pago", "shape": "tile", "icon": "briefcase", "color": "violet" }
