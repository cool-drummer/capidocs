    {
      "id": "publish-pipeline",
      "title": "Publicación de un portal",
      "description": "El recorrido de un cambio desde el borrador hasta el sitio en línea, etapa por etapa.",
      "category": "operational",
      "direction": "LR",
      "tags": [
        "proceso"
      ],
      "lanes": [
        {
          "id": "edit",
          "title": "Edición",
