    {
      "id": "boot-sequence",
      "title": "Arranque del sitio",
      "description": "Qué pasa desde que el navegador pide la página hasta que la documentación queda lista para leerse.",
      "category": "technical",
      "kind": "sequence",
      "autonumber": true,
      "participants": [
        {
          "id": "browser",
          "title": "Navegador",
          "kind": "actor"
        },
        {
          "id": "cdn",
          "title": "Cloudflare Pages",
          "kind": "external",
          "icon": "brand:cloudflare"
        },
        {
          "id": "main",
          "title": "main.js",
          "subtitle": "assets/js",
          "icon": "code",
          "color": "teal"
        },
        {
          "id": "loader",
          "title": "spec-loader",
          "subtitle": "assets/js",
          "icon": "file-json",
          "color": "teal",
          "link": {
            "diagram": "spec-model"
          }
        },
        {
          "id": "app",
          "title": "Aplicación",
          "subtitle": "app.js",
          "icon": "layers",
          "color": "violet",
          "link": {
            "diagram": "architecture",
            "node": "runtime"
          }
        }
      ],
      "items": [
        {
          "id": "m-get",
          "from": "browser",
          "to": "cdn",
          "label": "GET index.html"
        },
        {
          "from": "cdn",
          "to": "browser",
          "label": "HTML y módulos ES",
          "style": "reply"
        },
        {
          "id": "m-import",
          "from": "browser",
          "to": "main",
          "label": "Ejecuta el módulo"
        },
        {
          "from": "main",
          "to": "loader",
          "label": "loadSpec()"
        },
        {
          "type": "block",
          "kind": "alt",
          "label": "Hay un spec elegido",
          "items": [
            {
              "from": "loader",
              "to": "cdn",
              "label": "GET spec del idioma"
            }
          ],
          "branches": [
            {
              "label": "Spec por omisión",
              "items": [
                {
                  "from": "loader",
                  "to": "cdn",
                  "label": "GET config/api-spec.json"
                }
              ]
            }
          ]
        },
        {
          "from": "cdn",
          "to": "loader",
          "label": "JSON del spec",
          "style": "reply"
        },
        {
          "id": "m-create",
          "from": "main",
          "to": "app",
          "label": "createCapidocs(spec)"
        },
        {
          "type": "block",
          "kind": "loop",
          "label": "Cada sección de la página",
          "items": [
            {
              "from": "app",
              "to": "app",
              "label": "Pinta el bloque",
              "style": "async"
            }
          ]
        },
        {
          "type": "note",
          "over": [
            "main",
            "app"
          ],
          "text": "Sin temporizadores: un solo flujo de arranque y una bandera al final."
        },
        {
          "id": "m-ready",
          "from": "app",
          "to": "browser",
          "label": "data-capidocs = ready",
          "style": "reply"
        }
      ],
      "steps": [
        {
          "title": "Descarga",
          "description": "El navegador recibe el HTML y los módulos.",
          "edges": [
            "m-get"
          ]
        },
        {
          "title": "Carga del spec",
          "description": "Se elige el spec según el idioma o la versión.",
          "edges": [
            "m-import"
          ]
        },
        {
          "title": "La página queda lista",
          "description": "La bandera permite verificar el sitio sin navegador visible.",
          "edges": [
            "m-create",
            "m-ready"
          ]
        }
      ]
    },
    {
