          "color": "orange",
          "lane": "ship"
        },
        {
          "id": "live",
          "title": "En línea",
          "shape": "pill",
          "color": "green",
          "lane": "ship",
          "status": "ok"
        }
      ],
      "edges": [
        {
          "id": "p1",
          "from": "draft",
          "to": "valid"
        },
        {
          "id": "p2",
          "from": "valid",
